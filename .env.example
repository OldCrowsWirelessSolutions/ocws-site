# ocws-site environment variables (example — copy to .env.local and fill in)
#
# Only variables required by features in this repo are listed here. Generate
# strong random values for any *_SECRET entries (e.g. `openssl rand -hex 32`).
# Never commit real credentials.

# ── Upstash Redis (REST transport, serverless-safe) ─────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Anthropic (Corvus chat + knowledge) ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe (checkout, subscriptions, webhook, cron metrics aggregation) ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── V2 daily business-metrics cron ──────────────────────────────────────────
# Protects /api/v2/cron/business-metrics-daily against public invocation.
# Vercel Cron automatically sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=your-random-secret-here

# ── Admin / founder bypass ─────────────────────────────────────────────────
OCWS_ADMIN_SECRET=
